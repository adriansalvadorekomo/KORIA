# GabèsEye — system architecture (D2 source)
# Render: d2 docs/architecture.d2 docs/architecture.svg
# Also see docs/architecture.dot (Graphviz equivalent).

direction: down

classes: {
  space: {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
      border-radius: 8
    }
  }
  field: {
    style: {
      fill: "#FEF3E2"
      stroke: "#B7791F"
      border-radius: 8
    }
  }
  ml: {
    style: {
      fill: "#FDECEA"
      stroke: "#EE4C2C"
      border-radius: 8
    }
  }
  serve: {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
      border-radius: 8
    }
  }
}

sat: "Satellite imagery\nmultispectral" {
  class: space
}
seg: "PyTorch segmentation\nsoil contamination · water turbidity" {
  class: ml
}
sensors: "Field sensors\n20+ IoT devices" {
  class: field
}
airbyte: "Airbyte sync\nno manual wrangling" {
  class: field
}
db: "Central database" {
  class: field
}
ts: "scikit-learn time-series\ntrend forecasting · air quality" {
  class: ml
}
api: "FastAPI backend\nREST + data services" {
  class: serve
}
app: "Flutter app\nmaps · charts · chatbot · biometrics" {
  class: serve
}

sat -> seg: pixels
sensors -> airbyte: streams
airbyte -> db: loads
seg -> api: predictions
db -> ts: series
ts -> api: forecasts
api -> app: JSON/REST
