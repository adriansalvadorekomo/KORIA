# GabèsEye — system architecture (D2 source)
# Render: d2 docs/architecture.d2 docs/architecture.svg
# Also see docs/architecture.dot (Graphviz) and docs/architecture.mmd (Mermaid).

direction: right

Sensing: {
  sat: "Satellite imagery\nmultispectral" {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
    }
  }

  sensors: "Field sensors\n20+ IoT devices" {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
    }
  }
}

"Data & Intelligence": {
  direction: right

  seg: "PyTorch segmentation\nsoil · water turbidity" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  airbyte: "Airbyte sync\nno manual wrangling" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  db: "Central database" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  ts: "scikit-learn time-series\ntrends · air quality" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  airbyte -> db: loads
  db -> ts: series
}

Serving: {
  api: "FastAPI backend\nREST + data services" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }
}

"Flutter App": {
  maps: "Maps · Charts\nflutter_map · fl_chart" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  chatbot: "Multilingual chatbot\nenvironmental queries" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  roles: "Role screens\nfarmer · fisherman · authority" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }
}

Sensing.sat -> "Data & Intelligence".seg: pixels
Sensing.sensors -> "Data & Intelligence".airbyte: streams
"Data & Intelligence".seg -> Serving.api: predictions
"Data & Intelligence".ts -> Serving.api: forecasts
Serving.api -> "Flutter App".maps: JSON/REST
Serving.api -> "Flutter App".chatbot: JSON/REST
Serving.api -> "Flutter App".roles: JSON/REST
